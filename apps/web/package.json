{
  "name": "@ctrlc/web",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:showcases": "uv run python scripts/prepare_showcases.py",
    "dev": "bun run prepare:showcases && bun run vite dev --host 127.0.0.1",
    "build": "bun run prepare:showcases && bun run vite build",
    "preview": "bun run scripts/serve-static.ts",
    "typecheck": "bun run prepare:showcases && bunx tsc --noEmit",
    "test:e2e": "bun run build && bunx playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
